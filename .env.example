# --- tempest-meshtastic-weather example env ---
# Copy to .env and fill in real values. .env is gitignored.
# All of these can ALSO be set in config.yaml; env vars take precedence.

# ===== Tempest source =====
# Pick ONE source:
#   - "cloud"  -> WeatherFlow REST API (works anywhere, needs personal token + station_id)
#   - "udp"    -> local Tempest Hub UDP broadcast on port 50222 (no token needed, same LAN as Hub)
#   - "garden_api" -> a shared HTTP listener you control (advanced; see docs)
TEMPEST_SOURCE=cloud

# Required when TEMPEST_SOURCE=cloud
# Personal token: https://tempestwx.com/settings/tokens
TEMPEST_API_TOKEN=
TEMPEST_STATION_ID=

# Optional: how long to listen for UDP packets per fetch when TEMPEST_SOURCE=udp
TEMPEST_UDP_PORT=50222
TEMPEST_UDP_LISTEN_SECONDS=60

# Optional: garden_api endpoint (only when TEMPEST_SOURCE=garden_api)
GARDEN_API_URL=
TEMPEST_LOCAL_TOKEN=

# ===== MeshMonitor target =====
# MeshMonitor exposes POST /api/v1/messages.
# See https://github.com/Yeraze/meshmonitor
MESHMONITOR_URL=http://localhost:8080
MESHMONITOR_API_TOKEN=

# Channel index to broadcast on (0 = primary)
MESHMONITOR_CHANNEL_INDEX=0

# ===== Location strategy =====
# fixed -> use LOCATION_NAME + LOCATION_LAT/LON (good for a stationary station)
# from_meshmonitor -> read GPS from a MeshMonitor node (good for mobile rigs)
LOCATION_STRATEGY=fixed
LOCATION_NAME=Home
LOCATION_LAT=
LOCATION_LON=

# When LOCATION_STRATEGY=from_meshmonitor, refuse to broadcast if position is older than this (seconds)
LOCATION_MESHMONITOR_NODE_ID=
LOCATION_POSITION_MAX_AGE_SECONDS=86400

# ===== Severe weather alerter =====
# Uses NWS (USA only) + Open-Meteo forecast. Disable if you don't want it.
SEVERE_ALERTER_ENABLED=true
SEVERE_NWS_USER_AGENT=tempest-meshtastic-weather (set-me@example.com)
SEVERE_ALERT_CHANNEL_INDEX=0
SEVERE_DEDUP_TTL_HOURS=6
SEVERE_FORECAST_LEAD_HOURS=6
SEVERE_FORECAST_LEAD_DEBOUNCE_SECONDS=3600
SEVERE_CURRENT_RAIN_DEBOUNCE_SECONDS=1800
SEVERE_HEAVY_RAIN_MM_PER_HR=2.0
SEVERE_MIN_RAIN_MM=0.1
SEVERE_STATE_DIR=./state

# ===== Logging =====
TEMPEST_MESH_LOG_LEVEL=INFO
